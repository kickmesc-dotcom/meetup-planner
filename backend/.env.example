# SemiTaskBot — окружение бэкенда (HR-бот ресторана).
#
# Файл описывает НОВЫЙ контур. Набор короче прежнего (meetup-planner «шестёрки»):
# после разделения проектов шуточные механики — чухан/лох/червь/мемы/музыка/
# zaebal/игровая система GHG10 — уехали в `app/_legacy` и переменных окружения
# больше не читают. Что осталось — рабочий контур: сотрудники, чек-листы смены,
# поручения АУП, ссылки, обратная связь, встречи и напоминания.
#
# Живые значения в репозиторий не попадают: боевые ключи лежат в DPAPI-хранилище
# рабочей машины (`secrets/store.dpapi`) и в `PROMT/semiCREDS.txt` (он в
# .gitignore). Здесь — только форма.

# --- Telegram ---
BOT_TOKEN=123                                 # токен @SemiTaskBot
TG_WEBHOOK_SECRET=change-me-to-32-byte-hex    # наш секрет вебхука, НЕ из BotFather
# BOT_API_SERVER=                             # заполнять, только если хостинг не
#                                             # видит api.telegram.org (CF-worker
#                                             # прокси). На Amvera доступ прямой —
#                                             # переменную не задаём.

# --- Адреса ---
MINI_APP_URL=https://example.pages.dev        # Cloudflare Pages мини-аппа
PUBLIC_BASE_URL=https://example.amvera.io     # адрес самого бэкенда (для setWebhook,
#                                             # без слэша на конце)
CORS_ORIGINS=https://example.pages.dev        # через запятую, без пробелов

# --- База: отдельный проект Neon ---
# ВАЖНО: не подставлять DSN боевого meetup-planner. Миграции 0029–0031 создают
# таблицы HR-ядра (сотрудники, чек-листы, поручения, скрытые ачивки) — в чужой
# базе им нечего делать. Neon отдаёт DSN вида
# `postgresql://user:pw@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require`;
# код сам приводит его к `postgresql+asyncpg://` (см. `app/db/base.py`).
DATABASE_URL=123

# --- Права ---
# Telegram-ID администраторов бота. Владельцы контура уже зашиты в код
# (`config.BUILTIN_ADMIN_TG_IDS`) и в HR-сид (`db/hr_seed.seed_owners`), поэтому
# здесь держим только дополнительных админов. Роли внутри приложения раздаются
# отдельно: `employees.role` = employee / aup / admin.
ADMIN_TG_IDS=306733739,397594558

# --- Наследное (читается только отложенным контуром) ---
# WHITELIST_TG_IDS — список «шестёрки» для чатовых команд и сидинга `users`.
# В новом продукте сотрудники заводятся в HR-профиле, а не вайтлистом, но сид
# `users` по-прежнему читает эту переменную: пустая = никого не добавляем.
WHITELIST_TG_IDS=
WHITELIST_NAMES=

# --- Push в браузере (B2B_PLATFORM_PLAN, 2.4) ---
# Пара VAPID. Публичную отдаём браузеру, приватная остаётся на сервере.
# Пусто — push выключен, напоминания идут как раньше (колокольчик + Telegram).
# Сгенерировать: `python -m py_vapid --applicationServerKey`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@semitask.bot

# --- Перевод данных на месте (план, 11) ---
# Кнопка «перевести» на поручениях и пунктах чек-листа. Модели работают только
# там, где хватает памяти: HF Space (16 ГБ) — да, Amvera (0,5 ГБ) — нет, но
# Amvera отдаёт уже посчитанное из общей базы `translation_cache`.
#
# Пусто — перевод выключен, приложение работает как раньше (кнопки не будет).
# Свои веса: TRANSLATE_MODEL_DIR / TRANSLATE_UZ_MODEL_DIR; скачивание с HF:
# TRANSLATE_MODEL_REPO / TRANSLATE_UZ_MODEL_REPO.
TRANSLATE_MODEL_REPO=solavr/small100-ctranslate2-int8
TRANSLATE_UZ_MODEL_REPO=booba-uz/english-uzbek-translation_v3
TRANSLATE_MODEL_DIR=
TRANSLATE_UZ_MODEL_DIR=
# `off` полностью выключает перевод, даже если модели указаны.
TRANSLATE_PROVIDER=

# --- Прочее ---
GROUP_CHAT_ID=                                # рабочий чат, если нужны анонсы
SCHEDULER_TZ=Europe/Moscow
LOG_LEVEL=INFO
