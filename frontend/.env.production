# Прод-адрес API (Amvera, проект meetup-planner).
#
# Живёт в репозитории, а не в голове деплойщика: без VITE_API_BASE бандл
# стучится в `/api` на самом Cloudflare Pages, где API нет — страница
# открывается, данных нет. Значение не секрет: это публичный адрес.
#
# При переезде API (например, на Cloudflare Containers) — менять здесь и
# пересобирать фронт; вебхук бота при этом перепривязывается отдельно.
VITE_API_BASE=https://meetup-planner-youmakemefry.waw0.amvera.tech
