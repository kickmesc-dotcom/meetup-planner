__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example
# Прод-адрес API для сборки фронта: это публичный URL, не секрет. Без него
# сборка молча уедет на same-origin `/api`, которого на Pages нет.
!frontend/.env.production
.mypy_cache/
.pytest_cache/
.ruff_cache/

node_modules/
dist/
.vite/
*.tsbuildinfo
.eslintcache
# скомпилированный мусор от tsc -b рядом с исходниками (.tsx → .js)
frontend/src/**/*.js

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

fly/
.fly/

# Локальные контент-дропы фраз (реальные тексты группы) — НЕ для публичного репо
phrase-drop-*.json

# Живой смоук вне Telegram: настоящий initData на время проверки (GHG11) —
# это учётные данные, в репозиторий не попадают.
frontend/.devinit-tmp.txt

# Локальная база репетиции первого запуска (tools/rehearsal.py)
.rehearsal.db
.rehearsal.db-wal
.rehearsal.db-shm

# Файловая база из живых тестов периметра (tests/test_cors_policy.py)
.test_cors.db
.test_cors.db-wal
.test_cors.db-shm
.corsprobe.db
